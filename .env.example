APP_NAME="ИВМ · SMM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost:8000
APP_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Вход в портал (общий логин и пароль)
PORTAL_LOGIN=admin
PORTAL_PASSWORD=

# Python для telegram/stats.py (по умолчанию telegram/.venv или python3)
# PYTHON_BIN=
